[core]
    editor = vim
    whitespace = trailing-space,space-before-tab
    pager = less -FRX
    excludesfile = ~/.gitignore
[alias]
    st = status
    co = checkout
    plog = log --graph --abbrev-commit --decorate --date=relative --format=tformat:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(bold magenta)@ %an%C(reset)%C(bold yellow)%d%C(reset)'
[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[diff]
    algorithm = histogram
    colorMoved = default
[merge]
    conflictStyle = zdiff3
[rerere]
    enabled = true
[fetch]
    prune = true
[pull]
    rebase = false
[push]
    autoSetupRemote = true

; Machine-specific settings (user.name, user.email, signing key, ...), not tracked
[include]
    path = ~/.gitconfig.local
